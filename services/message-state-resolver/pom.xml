<?xml version="1.0" encoding="UTF-8"?>
<!--
  services_specifictaion.md §3.2: Java 25, Kafka Streams, RocksDB state
  store, exactly_once_v2. Как и billing-service/delivery-service: plain
  Java + built-in com.sun.net.httpserver вместо полного Kafka Streams
  DSL/RocksDB — намеренное упрощение (см. README "Что упрощено"): реальная
  транзакционная гарантия HLD §10.1 (changelog-запись + message.lifecycle +
  commit offset в одной Kafka-транзакции) реализована через настоящий
  transactional KafkaProducer (initTransactions/beginTransaction/
  sendOffsetsToTransaction/commitTransaction) — тот же API, что использует
  Kafka Streams EOS под капотом, только без топологии DSL поверх него.
  Локальная проекция состояния — in-memory (не RocksDB) в этом срезе.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>uz.mpp</groupId>
  <artifactId>message-state-resolver</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <protobuf.version>4.35.1</protobuf.version>
    <kafka.version>3.9.0</kafka.version>
    <junit.version>5.11.3</junit.version>
    <platform.contracts.dir>${project.basedir}/../../platform-contracts</platform.contracts.dir>
    <protobuf.protocExecutable>/opt/homebrew/bin/protoc</protobuf.protocExecutable>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>${protobuf.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>${kafka.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protocExecutable>${protobuf.protocExecutable}</protocExecutable>
          <protoSourceRoot>${platform.contracts.dir}</protoSourceRoot>
          <includes>
            <include>common/enums.proto</include>
            <include>common/types.proto</include>
            <include>common/stage_contract.proto</include>
            <include>events/message_events.proto</include>
          </includes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>uz.mpp.msr.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
